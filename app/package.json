{
  "name": "worship-box",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "homepage": "https://worshipbox.vercel.app",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "vercel --prod --yes",
    "links:audit": "node tools/audit-secuencias-links.cjs --input src/data/secuencias.json --output ../secuencias_link_health.json --simple ../secuencias_links_problematicos.json --csv ../secuencias_links_problematicos.csv",
    "data:public": "node tools/build-public-secuencias.cjs --input src/data/secuencias.json --health ../secuencias_link_health.json --output src/data/secuencias-public.json --report ../secuencias_public_build_report.json",
    "refresh:public": "npm run links:audit && npm run data:public",
    "deploy:public": "npm run refresh:public && npm run build && npm run deploy"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@vercel/analytics": "^1.6.1",
    "i18next": "^23.12.2",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^14.1.2",
    "sweetalert2": "^11.26.18",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^7.2.4"
  }
}
