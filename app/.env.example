# ═══════════════════════════════════════════════════════════════════════════════
#   EmailJS - Configuración para envío de formularios
#   https://www.emailjs.com/
# ═══════════════════════════════════════════════════════════════════════════════
# 
# IMPORTANTE: Estas variables deben configurarse en Vercel:
#   Vercel Dashboard → Project → Settings → Environment Variables
#
# Si NO están configuradas, el formulario funciona en modo simulación
# (muestra éxito pero no envía correo real).

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_FORM_ID=
VITE_EMAILJS_TEMPLATE_THANKS_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Email de destino donde recibirás los aportes (opcional)
VITE_EMAILJS_TO_EMAIL=worshipbox.ministry@gmail.com

# "false" para desactivar el adjunto XLSX en los correos (opcional)
# VITE_EMAILJS_ATTACH_XLSX=false

# Endpoint alternativo para enviar formularios via backend/serverless (opcional)
# VITE_CONTRIBUTE_ENDPOINT=https://tu-api.vercel.app/api/contribute
